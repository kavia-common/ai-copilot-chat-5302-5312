# Backend API base URL
REACT_APP_API_BASE=http://localhost:3001

# Alternative backend URL variables (for compatibility)
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_API_URL=http://localhost:3001

# Gemini API configuration (not used in frontend, but kept for reference)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here
REACT_APP_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
REACT_APP_GEMINI_MODEL=gemini-pro

# CORS allowed origins
REACT_APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3002
